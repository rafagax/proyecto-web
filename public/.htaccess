# =====================================================================
#  webraf.com  —  React Router static site (SSG) on Apache / cPanel
#  Vite copies this file into build/client/. Upload it with the build.
#  Rule order matters: https+host -> trailing slash -> legacy slugs ->
#  real files -> clean URLs. A syntax error here 500s the whole site.
# =====================================================================

# Default document per folder + no directory listings.
DirectoryIndex index.html
Options -Indexes -MultiViews

# Do NOT auto-append a trailing slash to directory URLs: we serve the
# prerendered index.html directly so the canonical (no-slash) URLs stay HTTP 200.
DirectorySlash Off

# Styled 404 page (served WITH a real HTTP 404 status). /404.html is a flat copy
# of the prerendered /404/index.html made by scripts/generate-seo-files.mjs
# (postbuild). Spanish URLs get their own Spanish 404 via the generated
# build/client/es/.htaccess (ErrorDocument is inherited per directory).
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical origin: https:// without "www." in a single 301 --------
  # (One hop instead of the old www->apex + panel http->https chain.)
  # The last condition always matches and captures the host minus "www." as %1.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- Canonical trailing slash (301) -----------------------------------
  # /es is the only canonical WITH a trailing slash (Spanish home is /es/).
  RewriteRule ^es$ /es/ [R=301,L]
  # Everything else: strip the trailing slash (/services/ -> /services).
  # THE_REQUEST is the raw request line sent by the client, so this only fires
  # on external requests — never on the internal /index.html rewrites below
  # (no redirect loops).
  RewriteCond %{THE_REQUEST} \s/(.+)/[?\s]
  RewriteCond %{REQUEST_URI} !^/es/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- Legacy blog slug -> current canonical slug (301) -----------------
  RewriteRule ^blog/why-your-business-needs-website-2025/?$ /blog/why-your-business-needs-a-website [R=301,L]
  RewriteRule ^es/blog/why-your-business-needs-website-2025/?$ /es/blog/por-que-tu-negocio-necesita-un-sitio-web [R=301,L]

  # --- Old English-slug Spanish articles -> translated ES slugs (301) ---
  RewriteRule ^es/blog/why-your-business-needs-a-website/?$ /es/blog/por-que-tu-negocio-necesita-un-sitio-web [R=301,L]
  RewriteRule ^es/blog/local-seo-rank-number-one-city-google/?$ /es/blog/seo-local-como-posicionar-tu-negocio-en-google [R=301,L]
  RewriteRule ^es/blog/ai-chatbots-24-7-sales-tool/?$ /es/blog/chatbots-ia-ventas-automaticas-24-7 [R=301,L]
  RewriteRule ^es/blog/launch-online-store-7-days/?$ /es/blog/crear-tienda-online-en-7-dias [R=301,L]
  RewriteRule ^es/blog/web-performance-core-web-vitals/?$ /es/blog/velocidad-web-core-web-vitals [R=301,L]
  RewriteRule ^es/blog/mobile-first-design-strategy/?$ /es/blog/diseno-web-mobile-first [R=301,L]

  # --- Serve real existing files directly (JS, CSS, images, sitemap...) -
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- Clean URLs: /path -> /path/index.html (internal, no redirect) ----
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

# --- Compression: Brotli when available, gzip as fallback --------------
# (mod_deflate skips responses that already carry a Content-Encoding, so
# having both blocks never double-compresses.)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Cache policy -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType font/woff2             "access plus 1 year"
  # HTML must revalidate so content updates show up immediately.
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints everything under /assets/ (name-<hash>.ext), so those
  # files never change in place: cache 1 year and mark immutable (browsers
  # skip revalidation entirely).
  SetEnvIf Request_URI "^/assets/" HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

  # Prerendered HTML must always revalidate so deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
