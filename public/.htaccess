# =====================================================================
#  webraf.com  —  React Router static site (SSG) on Apache / cPanel
#  Replaces what vercel.json did. Upload alongside the rest of the build.
# =====================================================================

# Default document per folder + no directory listings.
DirectoryIndex index.html
Options -Indexes -MultiViews

# Do NOT auto-append a trailing slash to directory URLs: we serve the
# prerendered index.html directly so the canonical (no-slash) URLs stay HTTP 200.
DirectorySlash Off

# Styled 404 page (served WITH a real HTTP 404 status).
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host: strip "www." (keeps the same http/https scheme) ---
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

  # --- Force HTTPS ------------------------------------------------------
  # ENABLE THIS ONLY AFTER cPanel AutoSSL has issued the certificate for
  # webraf.com (i.e. the site already loads on https:// with a padlock).
  # To turn it on, delete the "# " at the start of the next two lines:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Serve real existing files directly (JS, CSS, images, sitemap...) -
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- Clean URLs: /path -> /path/index.html (internal, no redirect) ----
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

# --- Gzip compression -------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Cache fingerprinted assets aggressively --------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp             "access plus 6 months"
  ExpiresByType image/png              "access plus 6 months"
  ExpiresByType image/jpeg             "access plus 6 months"
  ExpiresByType image/svg+xml          "access plus 6 months"
  ExpiresByType font/woff2             "access plus 1 year"
  # HTML must revalidate so content updates show up immediately.
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>
